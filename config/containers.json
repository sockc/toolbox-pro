[
  {
    "id": "portainer",
    "name": "容器管理面板（Portainer）",
    "image": "portainer/portainer-ce:latest",
    "ports": ["9000:9000", "9443:9443"],
    "volumes": [
      "/var/run/docker.sock:/var/run/docker.sock",
      "/opt/apps/portainer/data:/data"
    ],
    "extra": "--restart=always",
    "notes": "推荐访问：https://IP:9443 或 http://IP:9000",
    "show_after_install": true
  },
  {
    "id": "watchtower",
    "name": "自动更新容器（Watchtower）",
    "image": "containrrr/watchtower:latest",
    "ports": [],
    "volumes": ["/var/run/docker.sock:/var/run/docker.sock"],
    "extra": "--restart=always --cleanup --schedule \"0 0 4 * * *\"",
    "notes": "每天凌晨4点自动更新容器（需谨慎，建议先用于低风险容器）",
    "show_after_install": true
  },
  {
    "id": "npm",
    "name": "反代面板（Nginx Proxy Manager）",
    "image": "jc21/nginx-proxy-manager:latest",
    "ports": ["80:80", "81:81", "443:443"],
    "volumes": [
      "/opt/apps/npm/data:/data",
      "/opt/apps/npm/letsencrypt:/etc/letsencrypt"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:81 默认账号：admin@example.com 默认密码：changeme（首次登录务必修改）",
    "show_after_install": true
  },
  {
    "id": "lucky",
    "name": "反向代理一体化（Lucky）",
    "image": "gdy666/lucky:v2",
    "ports": ["16601:16601"],
    "volumes": [
      "/opt/apps/lucky/conf:/app/conf",
      "/var/run/docker.sock:/var/run/docker.sock"
    ],
    "extra": "--restart=always --net=host",
    "notes": "访问：http://IP:16601 默认账号/密码：666/666（建议立刻修改，并设置安全入口）",
    "show_after_install": true
  },
  {
    "id": "caddy",
    "name": "轻量反代（Caddy）",
    "image": "caddy:latest",
    "ports": ["80:80", "443:443"],
    "volumes": [
      "/opt/apps/caddy/Caddyfile:/etc/caddy/Caddyfile",
      "/opt/apps/caddy/data:/data",
      "/opt/apps/caddy/config:/config"
    ],
    "extra": "--restart=always",
    "notes": "需要自己写 Caddyfile，适合喜欢极简反代的用户",
    "show_after_install": true
  },
  {
    "id": "uptime-kuma",
    "name": "状态监控（Uptime Kuma）",
    "image": "louislam/uptime-kuma:latest",
    "ports": ["3001:3001"],
    "volumes": ["/opt/apps/uptime-kuma/data:/app/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:3001",
    "show_after_install": true
  },
  {
    "id": "vaultwarden",
    "name": "密码库（Vaultwarden）",
    "image": "vaultwarden/server:latest",
    "ports": ["8088:80"],
    "volumes": ["/opt/apps/vaultwarden/data:/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8088（建议配合反代上 HTTPS）",
    "show_after_install": true
  },
  {
    "id": "adguardhome",
    "name": "去广告 DNS（AdGuard Home）",
    "image": "adguard/adguardhome:latest",
    "ports": ["3000:3000", "53:53/udp", "53:53/tcp"],
    "volumes": [
      "/opt/apps/adguardhome/work:/opt/adguardhome/work",
      "/opt/apps/adguardhome/conf:/opt/adguardhome/conf"
    ],
    "extra": "--restart=always",
    "notes": "首次初始化访问：http://IP:3000（同时占用53端口）",
    "show_after_install": true
  },
  {
    "id": "pihole",
    "name": "去广告 DNS（Pi-hole）",
    "image": "pihole/pihole:latest",
    "ports": ["8081:80", "53:53/tcp", "53:53/udp"],
    "volumes": [
      "/opt/apps/pihole/etc-pihole:/etc/pihole",
      "/opt/apps/pihole/etc-dnsmasq.d:/etc/dnsmasq.d"
    ],
    "extra": "--restart=always",
    "env": ["TZ=Asia/Shanghai"],
    "secrets": [
      {
        "key": "WEBPASSWORD",
        "prompt": "Pi-hole 管理密码 WEBPASSWORD",
        "default": "pihole123456"
      }
    ],
    "notes": "访问：http://IP:8081/admin（会占用53端口）",
    "show_after_install": true
  },
  {
    "id": "homeassistant",
    "name": "智能家居（Home Assistant）",
    "image": "ghcr.io/home-assistant/home-assistant:stable",
    "ports": ["8123:8123"],
    "volumes": ["/opt/apps/homeassistant/config:/config"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8123",
    "show_after_install": true
  },
  {
    "id": "openlist",
    "name": "网盘目录（OpenList）",
    "image": "openlistteam/openlist:latest",
    "ports": ["5244:5244"],
    "volumes": ["/opt/apps/openlist/data:/opt/openlist/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:5244（首次进入设置管理员密码）",
    "show_after_install": true
  },
  {
    "id": "filebrowser",
    "name": "文件管理（FileBrowser）",
    "image": "filebrowser/filebrowser:latest",
    "ports": ["8082:80"],
    "volumes": [
      "/opt/apps/filebrowser/srv:/srv",
      "/opt/apps/filebrowser/database.db:/database.db",
      "/opt/apps/filebrowser/settings.json:/settings.json"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8082",
    "show_after_install": true
  },
  {
    "id": "syncthing",
    "name": "文件同步（Syncthing）",
    "image": "syncthing/syncthing:latest",
    "ports": ["8384:8384", "22000:22000", "21027:21027/udp"],
    "volumes": ["/opt/apps/syncthing:/var/syncthing"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8384",
    "show_after_install": true
  },
  {
    "id": "jellyfin",
    "name": "影音库（Jellyfin）",
    "image": "jellyfin/jellyfin:latest",
    "ports": ["8096:8096"],
    "volumes": [
      "/opt/apps/jellyfin/config:/config",
      "/opt/apps/jellyfin/cache:/cache",
      "/opt/media:/media"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8096",
    "show_after_install": true
  },
  {
    "id": "plex",
    "name": "影音库（Plex）",
    "image": "plexinc/pms-docker:latest",
    "ports": ["32400:32400"],
    "volumes": [
      "/opt/apps/plex/config:/config",
      "/opt/media:/media"
    ],
    "extra": "--restart=always --network=host",
    "notes": "Plex 常用 host 网络，Web 通常：http://IP:32400/web",
    "show_after_install": true
  },
  {
    "id": "emby",
    "name": "影音库（Emby）",
    "image": "emby/embyserver:latest",
    "ports": ["8097:8096"],
    "volumes": [
      "/opt/apps/emby/config:/config",
      "/opt/media:/media"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8097",
    "show_after_install": true
  },
  {
    "id": "navidrome",
    "name": "音乐库（Navidrome）",
    "image": "deluan/navidrome:latest",
    "ports": ["4533:4533"],
    "volumes": [
      "/opt/apps/navidrome/data:/data",
      "/opt/media/music:/music"
    ],
    "extra": "--restart=always",
    "env": ["ND_MUSICFOLDER=/music"],
    "notes": "访问：http://IP:4533",
    "show_after_install": true
  },
  {
    "id": "qbittorrent",
    "name": "下载器（qBittorrent）",
    "image": "lscr.io/linuxserver/qbittorrent:latest",
    "ports": ["8080:8080", "6881:6881", "6881:6881/udp"],
    "volumes": [
      "/opt/apps/qbittorrent/config:/config",
      "/opt/downloads:/downloads"
    ],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai", "WEBUI_PORT=8080"],
    "notes": "访问：http://IP:8080（首次默认账号通常：admin / adminadmin 或查看日志）",
    "show_after_install": true
  },
  {
    "id": "transmission",
    "name": "下载器（Transmission）",
    "image": "lscr.io/linuxserver/transmission:latest",
    "ports": ["9091:9091", "51413:51413", "51413:51413/udp"],
    "volumes": [
      "/opt/apps/transmission/config:/config",
      "/opt/downloads:/downloads"
    ],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai"],
    "notes": "访问：http://IP:9091",
    "show_after_install": true
  },
  {
    "id": "aria2-pro",
    "name": "下载器（Aria2 Pro）",
    "image": "p3terx/aria2-pro:latest",
    "ports": ["6800:6800"],
    "volumes": ["/opt/apps/aria2-pro/config:/config", "/opt/downloads:/downloads"],
    "extra": "--restart=always",
    "secrets": [
      {
        "key": "RPC_SECRET",
        "prompt": "Aria2 RPC 密钥（RPC_SECRET）",
        "default": "aria2rpc123456"
      }
    ],
    "notes": "RPC 端口：6800（配合 AriaNg 使用）",
    "show_after_install": true
  },
  {
    "id": "ariang",
    "name": "下载面板（AriaNg）",
    "image": "p3terx/ariang:latest",
    "ports": ["6880:6880"],
    "volumes": [],
    "extra": "--restart=always",
    "notes": "访问：http://IP:6880（需要手动配置 Aria2 RPC）",
    "show_after_install": true
  },
  {
    "id": "frps",
    "name": "内网穿透服务端（FRP Server）",
    "image": "snowdreamtech/frps:latest",
    "ports": ["7000:7000", "7500:7500"],
    "volumes": ["/opt/apps/frps/frps.ini:/etc/frp/frps.ini"],
    "extra": "--restart=always",
    "notes": "需要自己配置 frps.ini",
    "show_after_install": true
  },
  {
    "id": "frpc",
    "name": "内网穿透客户端（FRP Client）",
    "image": "snowdreamtech/frpc:latest",
    "ports": [],
    "volumes": ["/opt/apps/frpc/frpc.ini:/etc/frp/frpc.ini"],
    "extra": "--restart=always",
    "notes": "需要自己配置 frpc.ini",
    "show_after_install": true
  },
  {
    "id": "gitea",
    "name": "代码仓库（Gitea，推荐Compose）",
    "image": "gitea/gitea:latest",
    "ports": ["3002:3000", "2222:22"],
    "volumes": ["/opt/apps/gitea/data:/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:3002  SSH端口：2222",
    "show_after_install": true
  },
  {
    "id": "gitea-stack",
    "name": "代码仓库+数据库（Gitea Compose）",
    "compose": "version: '3'\nservices:\n  db:\n    image: mariadb:11\n    container_name: gitea-db\n    restart: always\n    environment:\n      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}\n      - MYSQL_DATABASE=gitea\n      - MYSQL_USER=gitea\n      - MYSQL_PASSWORD=${MYSQL_PASSWORD}\n    volumes:\n      - /opt/apps/gitea-stack/db:/var/lib/mysql\n  gitea:\n    image: gitea/gitea:latest\n    container_name: gitea\n    restart: always\n    ports:\n      - \"3002:3000\"\n      - \"2222:22\"\n    environment:\n      - GITEA__database__DB_TYPE=mysql\n      - GITEA__database__HOST=db:3306\n      - GITEA__database__NAME=gitea\n      - GITEA__database__USER=gitea\n      - GITEA__database__PASSWD=${MYSQL_PASSWORD}\n    volumes:\n      - /opt/apps/gitea-stack/data:/data\n    depends_on:\n      - db\n",
    "ports": [],
    "volumes": [],
    "extra": "",
    "secrets": [
      { "key": "MYSQL_ROOT_PASSWORD", "prompt": "Gitea-DB Root 密码", "default": "root123456" },
      { "key": "MYSQL_PASSWORD", "prompt": "Gitea-DB 用户密码", "default": "gitea123456" }
    ],
    "notes": "部署后访问：http://IP:3002  SSH端口：2222",
    "show_after_install": true
  },
  {
    "id": "code-server",
    "name": "网页IDE（Code Server）",
    "image": "lscr.io/linuxserver/code-server:latest",
    "ports": ["8444:8443"],
    "volumes": [
      "/opt/apps/code-server/config:/config",
      "/opt:/workspace"
    ],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai"],
    "secrets": [
      { "key": "PASSWORD", "prompt": "Code-Server 登录密码", "default": "codeserver123456" }
    ],
    "notes": "访问：https://IP:8444",
    "show_after_install": true
  },
  {
    "id": "registry",
    "name": "Docker 私有仓库（Registry）",
    "image": "registry:2",
    "ports": ["5000:5000"],
    "volumes": ["/opt/apps/registry/data:/var/lib/registry"],
    "extra": "--restart=always",
    "notes": "访问：IP:5000（建议配合反代+认证）",
    "show_after_install": true
  },
  {
    "id": "minio",
    "name": "对象存储（Minio）",
    "image": "minio/minio:latest",
    "ports": ["9001:9001", "9002:9000"],
    "volumes": ["/opt/apps/minio/data:/data"],
    "extra": "--restart=always",
    "env": ["MINIO_CONSOLE_ADDRESS=:9001"],
    "secrets": [
      { "key": "MINIO_ROOT_USER", "prompt": "Minio 管理账号", "default": "minioadmin" },
      { "key": "MINIO_ROOT_PASSWORD", "prompt": "Minio 管理密码", "default": "minioadmin123456" }
    ],
    "notes": "控制台：http://IP:9001  API：http://IP:9002",
    "show_after_install": true
  },
  {
    "id": "redis",
    "name": "缓存数据库（Redis）",
    "image": "redis:7-alpine",
    "ports": ["6379:6379"],
    "volumes": ["/opt/apps/redis/data:/data"],
    "extra": "--restart=always",
    "notes": "默认无密码（生产建议加 requirepass 或仅内网）",
    "show_after_install": true
  },
  {
    "id": "postgres",
    "name": "数据库（PostgreSQL）",
    "image": "postgres:16",
    "ports": ["5432:5432"],
    "volumes": ["/opt/apps/postgres/data:/var/lib/postgresql/data"],
    "extra": "--restart=always",
    "secrets": [
      { "key": "POSTGRES_PASSWORD", "prompt": "PostgreSQL 超级用户密码", "default": "postgres123456" }
    ],
    "notes": "端口：5432（建议内网使用或加防火墙限制）",
    "show_after_install": true
  },
  {
    "id": "mariadb",
    "name": "数据库（MariaDB）",
    "image": "mariadb:11",
    "ports": ["3306:3306"],
    "volumes": ["/opt/apps/mariadb/data:/var/lib/mysql"],
    "extra": "--restart=always",
    "secrets": [
      { "key": "MYSQL_ROOT_PASSWORD", "prompt": "MariaDB Root 密码", "default": "mariadb123456" }
    ],
    "notes": "端口：3306（建议内网使用或加防火墙限制）",
    "show_after_install": true
  },
  {
    "id": "mongodb",
    "name": "数据库（MongoDB）",
    "image": "mongo:7",
    "ports": ["27017:27017"],
    "volumes": ["/opt/apps/mongodb/data:/data/db"],
    "extra": "--restart=always",
    "notes": "端口：27017（生产建议加认证）",
    "show_after_install": true
  },
  {
    "id": "meilisearch",
    "name": "搜索引擎（MeiliSearch）",
    "image": "getmeili/meilisearch:latest",
    "ports": ["7700:7700"],
    "volumes": ["/opt/apps/meilisearch/data:/meili_data"],
    "extra": "--restart=always",
    "secrets": [
      { "key": "MEILI_MASTER_KEY", "prompt": "MeiliSearch 主密钥", "default": "meili123456masterkey" }
    ],
    "notes": "访问：http://IP:7700（需要主密钥）",
    "show_after_install": true
  },
  {
    "id": "grafana",
    "name": "可视化面板（Grafana）",
    "image": "grafana/grafana:latest",
    "ports": ["3003:3000"],
    "volumes": ["/opt/apps/grafana/data:/var/lib/grafana"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:3003 默认账号：admin 默认密码：admin（首次登录会要求修改）",
    "show_after_install": true
  },
  {
    "id": "prometheus",
    "name": "监控系统（Prometheus）",
    "image": "prom/prometheus:latest",
    "ports": ["9090:9090"],
    "volumes": [
      "/opt/apps/prometheus/prometheus.yml:/etc/prometheus/prometheus.yml",
      "/opt/apps/prometheus/data:/prometheus"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:9090（需要 prometheus.yml）",
    "show_after_install": true
  },
  {
    "id": "node-exporter",
    "name": "主机监控（Node Exporter）",
    "image": "prom/node-exporter:latest",
    "ports": ["9100:9100"],
    "volumes": ["/proc:/host/proc:ro", "/sys:/host/sys:ro", "/:/rootfs:ro"],
    "extra": "--restart=always --net=host --pid=host",
    "notes": "通常用于 Prometheus 抓取主机指标",
    "show_after_install": true
  },
  {
    "id": "dozzle",
    "name": "容器日志面板（Dozzle）",
    "image": "amir20/dozzle:latest",
    "ports": ["9999:8080"],
    "volumes": ["/var/run/docker.sock:/var/run/docker.sock"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:9999",
    "show_after_install": true
  },
  {
    "id": "dashy",
    "name": "导航页（Dashy）",
    "image": "lissy93/dashy:latest",
    "ports": ["4000:80"],
    "volumes": ["/opt/apps/dashy/conf.yml:/app/public/conf.yml"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:4000（需要 conf.yml）",
    "show_after_install": true
  },
  {
    "id": "heimdall",
    "name": "导航页（Heimdall）",
    "image": "lscr.io/linuxserver/heimdall:latest",
    "ports": ["4001:80"],
    "volumes": ["/opt/apps/heimdall/config:/config"],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai"],
    "notes": "访问：http://IP:4001",
    "show_after_install": true
  },
  {
    "id": "nextcloud-stack",
    "name": "网盘（Nextcloud Compose）",
    "compose": "version: '3'\nservices:\n  db:\n    image: mariadb:11\n    container_name: nextcloud-db\n    restart: always\n    environment:\n      - MYSQL_ROOT_PASSWORD=${MYSQL_ROOT_PASSWORD}\n      - MYSQL_DATABASE=nextcloud\n      - MYSQL_USER=nextcloud\n      - MYSQL_PASSWORD=${MYSQL_PASSWORD}\n    volumes:\n      - /opt/apps/nextcloud-stack/db:/var/lib/mysql\n  app:\n    image: nextcloud:latest\n    container_name: nextcloud\n    restart: always\n    ports:\n      - \"8083:80\"\n    environment:\n      - MYSQL_HOST=db\n      - MYSQL_DATABASE=nextcloud\n      - MYSQL_USER=nextcloud\n      - MYSQL_PASSWORD=${MYSQL_PASSWORD}\n    volumes:\n      - /opt/apps/nextcloud-stack/app:/var/www/html\n    depends_on:\n      - db\n",
    "ports": [],
    "volumes": [],
    "extra": "",
    "secrets": [
      { "key": "MYSQL_ROOT_PASSWORD", "prompt": "Nextcloud-DB Root 密码", "default": "root123456" },
      { "key": "MYSQL_PASSWORD", "prompt": "Nextcloud-DB 用户密码", "default": "nextcloud123456" }
    ],
    "notes": "部署后访问：http://IP:8083（首次进入创建管理员）",
    "show_after_install": true
  },
  {
    "id": "immich-stack",
    "name": "相册（Immich Compose）",
    "compose": "version: '3.8'\nservices:\n  immich-postgres:\n    image: postgres:16\n    container_name: immich-postgres\n    restart: always\n    environment:\n      - POSTGRES_PASSWORD=${POSTGRES_PASSWORD}\n      - POSTGRES_USER=immich\n      - POSTGRES_DB=immich\n    volumes:\n      - /opt/apps/immich-stack/postgres:/var/lib/postgresql/data\n  immich-redis:\n    image: redis:7-alpine\n    container_name: immich-redis\n    restart: always\n  immich-server:\n    image: ghcr.io/immich-app/immich-server:release\n    container_name: immich-server\n    restart: always\n    ports:\n      - \"2283:3001\"\n    environment:\n      - DB_HOSTNAME=immich-postgres\n      - DB_USERNAME=immich\n      - DB_PASSWORD=${POSTGRES_PASSWORD}\n      - DB_DATABASE_NAME=immich\n      - REDIS_HOSTNAME=immich-redis\n    volumes:\n      - /opt/apps/immich-stack/upload:/usr/src/app/upload\n    depends_on:\n      - immich-postgres\n      - immich-redis\n",
    "ports": [],
    "volumes": [],
    "extra": "",
    "secrets": [
      { "key": "POSTGRES_PASSWORD", "prompt": "Immich 数据库密码", "default": "immich123456" }
    ],
    "notes": "部署后访问：http://IP:2283",
    "show_after_install": true
  },
  {
    "id": "calibre-web",
    "name": "电子书（Calibre Web）",
    "image": "lscr.io/linuxserver/calibre-web:latest",
    "ports": ["8084:8083"],
    "volumes": [
      "/opt/apps/calibre-web/config:/config",
      "/opt/media/books:/books"
