    "show_after_install": true
  },
  {
    "id": "emby",
    "name": "影音库播放三号",
    "image": "emby/embyserver:latest",
    "ports": ["8097:8096"],
    "volumes": [
      "/opt/apps/emby/config:/config",
      "/opt/media:/media"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8097",
    "show_after_install": true
  },
  {
    "id": "navidrome",
    "name": "音乐库播放",
    "image": "deluan/navidrome:latest",
    "ports": ["4533:4533"],
    "volumes": [
      "/opt/apps/navidrome/data:/data",
      "/opt/media/music:/music"
    ],
    "extra": "--restart=always",
    "env": ["ND_MUSICFOLDER=/music"],
    "notes": "访问：http://IP:4533",
    "show_after_install": true
  },
  {
    "id": "qbittorrent",
    "name": "下载器一号",
    "image": "lscr.io/linuxserver/qbittorrent:latest",
    "ports": ["8080:8080", "6881:6881", "6881:6881/udp"],
    "volumes": [
      "/opt/apps/qbittorrent/config:/config",
      "/opt/downloads:/downloads"
    ],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai", "WEBUI_PORT=8080"],
    "notes": "访问：http://IP:8080（默认账号可能：admin/adminadmin 或查看日志）",
    "show_after_install": true
  },
  {
    "id": "transmission",
    "name": "下载器二号",
    "image": "lscr.io/linuxserver/transmission:latest",
    "ports": ["9091:9091", "51413:51413", "51413:51413/udp"],
    "volumes": [
      "/opt/apps/transmission/config:/config",
      "/opt/downloads:/downloads"
    ],
    "extra": "--restart=always",
    "env": ["PUID=1000", "PGID=1000", "TZ=Asia/Shanghai"],
    "notes": "访问：http://IP:9091",
    "show_after_install": true
  },
  {
    "id": "aria2-pro",
    "name": "下载器三号",
    "image": "p3terx/aria2-pro:latest",
    "ports": ["6800:6800"],
    "volumes": ["/opt/apps/aria2-pro/config:/config", "/opt/downloads:/downloads"],
    "extra": "--restart=always",
    "secrets": [
      { "key": "RPC_SECRET", "prompt": "下载密钥", "default": "aria2rpc123456" }
    ],
    "notes": "RPC端口：6800（配合网页面板使用）",
    "show_after_install": true
  },
  {
    "id": "ariang",
    "name": "下载器网页面板",
    "image": "p3terx/ariang:latest",
    "ports": ["6880:6880"],
    "volumes": [],
    "extra": "--restart=always",
    "notes": "访问：http://IP:6880（需要手动填 Aria2 RPC）",
    "show_after_install": true
  },
  {
    "id": "frps",
    "name": "内网穿透服务端",
    "image": "snowdreamtech/frps:latest",
    "ports": ["7000:7000", "7500:7500"],
    "volumes": ["/opt/apps/frps/frps.ini:/etc/frp/frps.ini"],
    "extra": "--restart=always",
    "notes": "需要自己准备 /opt/apps/frps/frps.ini",
