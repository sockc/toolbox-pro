[
  {
    "id": "portainer",
    "name": "容器管理面板",
    "image": "portainer/portainer-ce:latest",
    "ports": ["9000:9000", "9443:9443"],
    "volumes": [
      "/var/run/docker.sock:/var/run/docker.sock",
      "/opt/apps/portainer/data:/data"
    ],
    "extra": "--restart=always",
    "notes": "推荐访问：https://IP:9443 或 http://IP:9000",
    "show_after_install": true
  },
  {
    "id": "watchtower",
    "name": "自动更新容器",
    "image": "containrrr/watchtower:latest",
    "ports": [],
    "volumes": ["/var/run/docker.sock:/var/run/docker.sock"],
    "extra": "--restart=always --cleanup --schedule \"0 0 4 * * *\"",
    "notes": "每天凌晨4点自动更新容器（谨慎启用，建议先用于低风险容器）",
    "show_after_install": true
  },
  {
    "id": "npm",
    "name": "反代面板",
    "image": "jc21/nginx-proxy-manager:latest",
    "ports": ["80:80", "81:81", "443:443"],
    "volumes": [
      "/opt/apps/npm/data:/data",
      "/opt/apps/npm/letsencrypt:/etc/letsencrypt"
    ],
    "extra": "--restart=always",
    "notes": "访问：http://IP:81 默认账号：admin@example.com 默认密码：changeme（首次登录务必修改）",
    "show_after_install": true
  },
  {
    "id": "caddy",
    "name": "轻量反代",
    "image": "caddy:latest",
    "ports": ["80:80", "443:443"],
    "volumes": [
      "/opt/apps/caddy/Caddyfile:/etc/caddy/Caddyfile",
      "/opt/apps/caddy/data:/data",
      "/opt/apps/caddy/config:/config"
    ],
    "extra": "--restart=always",
    "notes": "需要自己写 Caddyfile，适合极简反代",
    "show_after_install": true
  },
  {
    "id": "uptime-kuma",
    "name": "状态监控面板",
    "image": "louislam/uptime-kuma:latest",
    "ports": ["3001:3001"],
    "volumes": ["/opt/apps/uptime-kuma/data:/app/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:3001",
    "show_after_install": true
  },
  {
    "id": "vaultwarden",
    "name": "密码库",
    "image": "vaultwarden/server:latest",
    "ports": ["8088:80"],
    "volumes": ["/opt/apps/vaultwarden/data:/data"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8088（建议反代上 HTTPS）",
    "show_after_install": true
  },
  {
    "id": "adguardhome",
    "name": "去广告DNS",
    "image": "adguard/adguardhome:latest",
    "ports": ["3000:3000", "53:53/udp", "53:53/tcp"],
    "volumes": [
      "/opt/apps/adguardhome/work:/opt/adguardhome/work",
      "/opt/apps/adguardhome/conf:/opt/adguardhome/conf"
    ],
    "extra": "--restart=always",
    "notes": "首次初始化访问：http://IP:3000（会占用53端口）",
    "show_after_install": true
  },
  {
    "id": "pihole",
    "name": "去广告DNS二号",
    "image": "pihole/pihole:latest",
    "ports": ["8081:80", "53:53/tcp", "53:53/udp"],
    "volumes": [
      "/opt/apps/pihole/etc-pihole:/etc/pihole",
      "/opt/apps/pihole/etc-dnsmasq.d:/etc/dnsmasq.d"
    ],
    "extra": "--restart=always",
    "env": ["TZ=Asia/Shanghai"],
    "secrets": [
      { "key": "WEBPASSWORD", "prompt": "管理密码", "default": "pihole123456" }
    ],
    "notes": "访问：http://IP:8081/admin（会占用53端口）",
    "show_after_install": true
  },
  {
    "id": "homeassistant",
    "name": "智能家居中心",
    "image": "ghcr.io/home-assistant/home-assistant:stable",
    "ports": ["8123:8123"],
    "volumes": ["/opt/apps/homeassistant/config:/config"],
    "extra": "--restart=always",
    "notes": "访问：http://IP:8123",
    "show_after_install": true
  },
  {
    "id": "openlist",
