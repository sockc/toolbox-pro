    "tool": "ctop",
    "category": "Docker 工具",
    "desc": "类似 top 的 Docker 容器 CPU、内存、网络监控。",
    "check": "command -v ctop",
    "install_type": "script",
    "install": "set -e; ARCH=$(uname -m); case \"$ARCH\" in x86_64|amd64) A=amd64 ;; aarch64|arm64) A=arm64 ;; armv7l|armv7) A=arm ;; *) echo \"不支持的架构: $ARCH\"; exit 1 ;; esac; URL=$(curl -fsSL https://api.github.com/repos/bcicen/ctop/releases/latest | jq -r --arg a \"linux-${A}\" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1); [ -n \"$URL\" ] && [ \"$URL\" != \"null\" ]; curl -fsSL \"$URL\" -o /usr/local/bin/ctop; chmod 755 /usr/local/bin/ctop",
    "uninstall": "rm -f /usr/local/bin/ctop",
    "upgrade": "rm -f /usr/local/bin/ctop; ARCH=$(uname -m); case \"$ARCH\" in x86_64|amd64) A=amd64 ;; aarch64|arm64) A=arm64 ;; armv7l|armv7) A=arm ;; *) exit 1 ;; esac; URL=$(curl -fsSL https://api.github.com/repos/bcicen/ctop/releases/latest | jq -r --arg a \"linux-${A}\" '.assets[] | select(.name | endswith($a)) | .browser_download_url' | head -n1); curl -fsSL \"$URL\" -o /usr/local/bin/ctop; chmod 755 /usr/local/bin/ctop",
